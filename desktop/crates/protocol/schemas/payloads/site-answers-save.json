{
  "$id": "https://resumepro.local/protocol/payloads/site-answers-save.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "site",
    "answers"
  ],
  "properties": {
    "site": {
      "description": "站点：小写 host（去掉 www.，带非默认端口），几家公司共用一个 host 的招聘平台再加一段公司路径（host[:port][/段]）。格式由校验器检查",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "answers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "previous": {
            "description": "用户确认时看到的桌面旧回答；不带表示桌面里本来没有这道题",
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    }
  }
}
