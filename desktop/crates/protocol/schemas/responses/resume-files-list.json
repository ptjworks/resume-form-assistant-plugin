{
  "$id": "https://resumepro.local/protocol/responses/resume-files-list.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "files"
  ],
  "properties": {
    "files": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fileId",
          "kind",
          "name",
          "label",
          "mime",
          "byteSize",
          "sha256",
          "isDefault",
          "templateIds",
          "updatedAt"
        ],
        "properties": {
          "fileId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "resume",
              "photo",
              "transcript",
              "other"
            ]
          },
          "name": {
            "description": "上传时用的文件名",
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "label": {
            "description": "用户写的说明，比如「英文简历」；没写是空串",
            "type": "string",
            "maxLength": 30
          },
          "mime": {
            "type": "string",
            "enum": [
              "application/pdf",
              "application/msword",
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
              "image/jpeg",
              "image/png"
            ]
          },
          "byteSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10485760
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "isDefault": {
            "type": "boolean"
          },
          "templateIds": {
            "description": "用于哪些模板；空数组是所有模板。绑定的模板删掉后 id 还留着，这样的文件不用于别的模板",
            "type": "array",
            "maxItems": 25,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          },
          "updatedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
          }
        }
      }
    }
  }
}
