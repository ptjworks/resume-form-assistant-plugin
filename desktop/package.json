{
  "name": "resume-pro-desktop",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "test:host": "cargo test --manifest-path crates/data-service/Cargo.toml --locked",
    "test:store": "cargo test --manifest-path crates/archive-store/Cargo.toml --locked",
    "test:ai-extract": "cargo test --manifest-path crates/ai-extract/Cargo.toml --locked",
    "test:resume-sheet": "cargo test --manifest-path crates/resume-sheet/Cargo.toml --locked",
    "test:mailbox": "cargo test --manifest-path crates/mailbox-sync/Cargo.toml --locked",
    "test:app": "cargo test --manifest-path src-tauri/Cargo.toml --locked --bins --lib",
    "test:frontend": "vite build",
    "test:ui": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "test:react": "vitest run",
    "test:nm-register": "node --test scripts/nm-dev-register.test.js",
    "test:uninstall-hooks": "node --test scripts/check-uninstall-hooks.test.js && node scripts/check-uninstall-hooks.js",
    "nm:register": "node scripts/nm-dev-register.mjs register",
    "nm:unregister": "node scripts/nm-dev-register.mjs unregister",
    "test:release-allowlist": "node --test scripts/check-plugin-release-allowlist.test.js && node scripts/check-plugin-release-allowlist.js",
    "test:desktop-release": "node --test scripts/check-desktop-release.test.js scripts/set-version.test.js scripts/release-beta.test.js scripts/pack-plugin.test.js scripts/chrome-web-store.test.js scripts/chrome-web-store-watch.test.js scripts/feedback-digest-watch.test.js && node scripts/check-desktop-release.js",
    "test:release-acceptance": "node --test scripts/check-release-acceptance.test.mjs",
    "test": "npm run typecheck && npm run test:host && npm run test:store && npm run test:mailbox && npm run test:ai-extract && npm run test:resume-sheet && npm run test:app && npm run test:frontend && npm run test:ui && npm run test:react && npm run test:nm-register && npm run test:uninstall-hooks && npm run test:release-allowlist && npm run test:desktop-release && npm run test:release-acceptance",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/extension-text-style": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "mammoth": "^1.12.3",
    "marked": "18.1.3",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "7.0.0"
  }
}
